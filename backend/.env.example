# Entorno
NODE_ENV=desarrollo/produccion
PORT=puerto_del_backend
APP_TIMEZONE=region/ciudad

# URLs públicas del frontend y del backend
FRONTEND_URL=url_del_frontend
API_URL=url_del_backend

# Supabase: nunca publiques las claves reales en GitHub ni en el frontend.
SUPABASE_URL=url_del_proyecto_supabase
SUPABASE_ANON_KEY=REEMPLAZAR_CON_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZAR_CON_SERVICE_ROLE_KEY

# Cloudinary: se requieren las tres variables por separado.
CLOUDINARY_CLOUD_NAME=REEMPLAZAR
CLOUDINARY_API_KEY=REEMPLAZAR
CLOUDINARY_API_SECRET=REEMPLAZAR

# Opcional: habilitar únicamente cuando exista un flujo de pago verificado por webhook.
# STRIPE_SECRET_KEY=sk_test_REEMPLAZAR
