{
  "compilerOptions": {
    /* Módulos y Resolución */
    "target": "ES2022",
    "module": "CommonJS",
    "ignoreDeprecations": "5.0", 
    
    /* Rutas absolutas (Alias) */
    "paths": {
      "@/*": ["./src/*"]
    },
    
    /* Directorios */
    "rootDir": "./src",
    "outDir": "./dist",
    
    /* Interoperabilidad (Evita errores con librerías de terceros) */
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    
    /* Reglas Estrictas */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    
    /* Optimización (CRÍTICO: ignora errores de librerías en node_modules) */
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}